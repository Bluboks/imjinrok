{
  "sourceExecutableSha256": "25a95d568082478ce0f50c89c9bbb9536ef33eb6904afa62903e9d63b7a5d03e",
  "sourceK0110Sha256": "d9dcc3c78d0373181677afc63fe9331ff561387e36877a62912ca66515f4aea8",
  "ownerVectors": [
    {
      "id": "first-load-success",
      "input": {
        "operations": [
          {
            "path": "ybriefingfnt\\K01\\k0101.spr",
            "loadResult": "success"
          }
        ]
      },
      "expected": {
        "events": [
          {
            "path": "ybriefingfnt\\K01\\k0101.spr",
            "released": false,
            "loaded": true,
            "recordAccepted": true,
            "imageAfter": "ybriefingfnt\\K01\\k0101.spr"
          }
        ],
        "finalImage": "ybriefingfnt\\K01\\k0101.spr",
        "ownerImageField": 1
      }
    },
    {
      "id": "same-path-repeated",
      "input": {
        "operations": [
          { "path": "sprite.spr", "loadResult": "success" },
          { "path": "sprite.spr", "loadResult": "success" }
        ]
      },
      "expected": {
        "events": [
          { "path": "sprite.spr", "released": false, "loaded": true, "recordAccepted": true, "imageAfter": "sprite.spr" },
          { "path": "sprite.spr", "released": true, "loaded": true, "recordAccepted": true, "imageAfter": "sprite.spr" }
        ],
        "finalImage": "sprite.spr",
        "ownerImageField": 1
      }
    },
    {
      "id": "different-path-replacement",
      "input": {
        "operations": [
          { "path": "a.spr", "loadResult": "success" },
          { "path": "b.spr", "loadResult": "success" }
        ]
      },
      "expected": {
        "events": [
          { "path": "a.spr", "released": false, "loaded": true, "recordAccepted": true, "imageAfter": "a.spr" },
          { "path": "b.spr", "released": true, "loaded": true, "recordAccepted": true, "imageAfter": "b.spr" }
        ],
        "finalImage": "b.spr",
        "ownerImageField": 1
      }
    },
    {
      "id": "failed-load-after-release",
      "input": {
        "initialImage": "a.spr",
        "operations": [
          { "path": "missing.spr", "loadResult": "failure" }
        ]
      },
      "expected": {
        "events": [
          { "path": "missing.spr", "released": true, "loaded": false, "recordAccepted": true, "imageAfter": null }
        ],
        "finalImage": null,
        "ownerImageField": 0
      }
    },
    {
      "id": "empty-source-failure",
      "input": {
        "operations": [
          { "path": "", "loadResult": "failure" }
        ]
      },
      "expected": {
        "events": [
          { "path": "", "released": false, "loaded": false, "recordAccepted": true, "imageAfter": null }
        ],
        "finalImage": null,
        "ownerImageField": 0
      }
    },
    {
      "id": "malformed-source-failure",
      "input": {
        "operations": [
          { "path": "not-a-sprite", "loadResult": "failure" }
        ]
      },
      "expected": {
        "events": [
          { "path": "not-a-sprite", "released": false, "loaded": false, "recordAccepted": true, "imageAfter": null }
        ],
        "finalImage": null,
        "ownerImageField": 0
      }
    }
  ],
  "directLoadGateVectors": [
    {
      "id": "existing-image-retained",
      "input": { "existingImage": "existing.spr", "path": "new.spr", "loadResult": "success" },
      "expected": { "branch": "already-allocated-memory", "imageAfter": "existing.spr", "returnValue": 1 }
    },
    {
      "id": "empty-slot-success",
      "input": { "path": "new.spr", "loadResult": "success" },
      "expected": { "branch": "load-success", "imageAfter": "new.spr", "returnValue": 1 }
    },
    {
      "id": "empty-slot-failure",
      "input": { "path": "missing.spr", "loadResult": "failure" },
      "expected": { "branch": "load-failure", "imageAfter": null, "returnValue": 1 }
    }
  ],
  "teardownVectors": [
    {
      "id": "image-and-overlays",
      "input": { "image": "title.spr", "objectiveActive": 1, "titleActive": 1 },
      "expected": { "releasedImage": true, "imageAfter": null, "objectiveAfter": 0, "titleAfter": 0, "overlayClearOrder": ["objective", "title"] }
    },
    {
      "id": "empty-and-clear",
      "input": { "image": null, "objectiveActive": 0, "titleActive": 0 },
      "expected": { "releasedImage": false, "imageAfter": null, "objectiveAfter": 0, "titleAfter": 0, "overlayClearOrder": ["objective", "title"] }
    }
  ]
}
