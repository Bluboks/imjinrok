{
  "name": "isorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "concurrently -n game,editor,server -c cyan,magenta,yellow \"pnpm dev:game\" \"pnpm dev:editor\" \"pnpm dev:server\"",
    "dev:game": "vite --config apps/game-client/vite.config.ts",
    "dev:editor": "vite --config apps/map-editor/vite.config.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "build": "pnpm run build:game && pnpm run build:editor && pnpm run build:server",
    "build:game": "vite build --config apps/game-client/vite.config.ts",
    "build:editor": "vite build --config apps/map-editor/vite.config.ts",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "typecheck": "tsc -p apps/game-client/tsconfig.json --noEmit && tsc -p apps/map-editor/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"tools/**/*.test.mjs\"",
    "imjinrok:inventory": "node tools/imjinrok/asset-inventory.mjs",
    "imjinrok:convert-sprites": "node tools/imjinrok/convert-sprites.mjs",
    "imjinrok:convert-audio": "node tools/imjinrok/convert-audio.mjs",
    "imjinrok:inspect-scripts": "node tools/imjinrok/inspect-scripts.mjs",
    "imjinrok:inspect-maps": "node tools/imjinrok/inspect-maps.mjs",
    "imjinrok:inspect-map-records": "node tools/imjinrok/inspect-map-records.mjs",
    "imjinrok:export-map": "node tools/imjinrok/export-map-definition.mjs",
    "imjinrok:extract-terrain-mask": "node tools/imjinrok/extract-map-terrain-mask.mjs",
    "imjinrok:extract-environment-assets": "node tools/imjinrok/extract-imjinrok-environment-assets.mjs --output analysis/fixtures/imjinrok-environment-assets.json",
    "imjinrok:extract-day-night-schedule": "node tools/imjinrok/extract-imjinrok-day-night-schedule.mjs",
    "imjinrok:export-environment-assets": "node tools/imjinrok/export-imjinrok-environment-assets.mjs",
    "imjinrok:export-k01-source-tile-visuals": "node tools/imjinrok/export-k01-source-tile-visuals.mjs",
    "imjinrok:export-source-fog-composites": "node tools/imjinrok/export-source-fog-composites.mjs",
    "imjinrok:extract-k01-global-mask-boundary": "node tools/imjinrok/extract-k01-global-mask-boundary.mjs",
    "imjinrok:extract-mission-portraits": "node tools/imjinrok/extract-mission-portrait-mapping.mjs --json",
    "imjinrok:extract-speech-layout": "node tools/imjinrok/extract-speech-layout-evidence.mjs --json",
    "imjinrok:extract-objective-panel-layout": "node tools/imjinrok/extract-objective-panel-layout-evidence.mjs --json",
    "imjinrok:extract-objective-modal-k01-binding": "node tools/imjinrok/extract-objective-modal-k01-binding.mjs --json",
    "imjinrok:extract-application-state-16-objective-control": "node tools/imjinrok/extract-application-state-16-objective-control.mjs --json",
    "imjinrok:extract-objective-pending-action-dispatch": "node tools/imjinrok/extract-objective-pending-action-dispatch.mjs --json",
    "imjinrok:extract-objective-modal-typography": "node tools/imjinrok/extract-objective-modal-typography.mjs --json",
    "imjinrok:extract-selection-panel-slot-dispatch": "node tools/imjinrok/extract-selection-panel-slot-dispatch.mjs --json",
    "imjinrok:extract-selection-panel-slot-lifecycle": "node tools/imjinrok/extract-selection-panel-slot-lifecycle.mjs --json",
    "imjinrok:extract-transient-formatted-overlay": "node tools/imjinrok/extract-transient-formatted-overlay.mjs --json",
    "imjinrok:extract-persistent-selection-action-boundary": "node tools/imjinrok/extract-persistent-selection-action-boundary.mjs --json",
    "imjinrok:extract-hero-priority-queue-gate": "node tools/imjinrok/extract-hero-priority-queue-gate.mjs --json",
    "imjinrok:extract-magic-auto-use-gate": "node tools/imjinrok/extract-magic-auto-use-gate.mjs --json",
    "imjinrok:extract-unit-animation-pilot": "node tools/imjinrok/extract-unit-animation-pilot.mjs --json",
    "imjinrok:extract-k01-hero-movement-pilot": "node tools/imjinrok/extract-k01-hero-movement-pilot.mjs --json",
    "imjinrok:extract-k01-hero-basic-attack-pilot": "node tools/imjinrok/extract-k01-hero-basic-attack-pilot.mjs --json",
    "imjinrok:extract-k01-samurai-animation-pilot": "node tools/imjinrok/extract-k01-samurai-animation-pilot.mjs --json",
    "imjinrok:extract-k01-turtle-tank-animation-pilot": "node tools/imjinrok/extract-k01-turtle-tank-animation-pilot.mjs --json",
    "imjinrok:extract-k01-konishi-animation-pilot": "node tools/imjinrok/extract-k01-konishi-animation-pilot.mjs --json",
    "imjinrok:extract-k01-japanese-farmer-frames": "node tools/imjinrok/extract-k01-japanese-farmer-frames.mjs --json",
    "imjinrok:extract-k01-farmer-resource-branch-frames": "node tools/imjinrok/extract-k01-farmer-resource-branch-frames.mjs --json",
    "imjinrok:extract-k01-farmer-resource-work-frames": "node tools/imjinrok/extract-k01-farmer-resource-work-frames.mjs --json",
    "imjinrok:extract-k01-farmer-state4-fallback-frames": "node tools/imjinrok/extract-k01-farmer-state4-fallback-frames.mjs --json",
    "imjinrok:extract-k01-normal-reinforcement-animation-batch": "node tools/imjinrok/extract-k01-normal-reinforcement-animation-batch.mjs --json",
    "imjinrok:extract-k01-opening-unit-bindings": "node tools/imjinrok/extract-k01-opening-unit-bindings.mjs",
    "imjinrok:extract-k01-opening-building-bindings": "node tools/imjinrok/extract-k01-opening-building-bindings.mjs",
    "imjinrok:extract-k01-reinforcement-placement-policy": "node tools/imjinrok/extract-k01-reinforcement-placement-policy.mjs --json",
    "imjinrok:extract-k01-tile-placement-elevation-evidence": "node tools/imjinrok/extract-k01-tile-placement-elevation-evidence.mjs --output analysis/fixtures/k01-tile-placement-elevation-evidence.json",
    "imjinrok:extract-source-pathfinding-evidence": "node tools/imjinrok/extract-source-pathfinding-evidence.mjs --output analysis/fixtures/source-pathfinding-evidence.json",
    "imjinrok:extract-building-state-pilot": "node tools/imjinrok/extract-building-state-pilot.mjs --json",
    "imjinrok:extract-beacon-state-pilot": "node tools/imjinrok/extract-beacon-state-pilot.mjs --json",
    "imjinrok:extract-k01-map-low-nibble-writers": "node tools/imjinrok/extract-k01-map-low-nibble-writers.mjs",
    "imjinrok:extract-source-fog-render-evidence": "node tools/imjinrok/extract-source-fog-render-evidence.mjs --output analysis/fixtures/source-fog-render-evidence.json",
    "imjinrok:extract-entity-type-catalog": "node tools/imjinrok/extract-entity-type-catalog.mjs --output analysis/generated/entity-type-catalog.json",
    "imjinrok:audit-sprite-mappings": "node --import tsx tools/imjinrok/audit-sprite-mappings.mjs",
    "imjinrok:setup-static-analysis": "bash tools/imjinrok/setup-static-analysis.sh",
    "imjinrok:analyze-exe": "bash tools/imjinrok/run-static-analysis.sh",
    "imjinrok:verify-static-analysis": "node tools/imjinrok/validate-static-analysis.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.0",
    "phaser": "3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
