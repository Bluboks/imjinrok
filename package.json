{
  "name": "isorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "concurrently -n game,editor,server -c cyan,magenta,yellow \"pnpm dev:game\" \"pnpm dev:editor\" \"pnpm dev:server\"",
    "dev:game": "vite --config apps/game-client/vite.config.ts",
    "dev:editor": "vite --config apps/map-editor/vite.config.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "build": "pnpm run build:game && pnpm run build:editor && pnpm run build:server",
    "build:game": "vite build --config apps/game-client/vite.config.ts",
    "build:editor": "vite build --config apps/map-editor/vite.config.ts",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "typecheck": "tsc -p apps/game-client/tsconfig.json --noEmit && tsc -p apps/map-editor/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit",
    "test": "node --import tsx --test \"packages/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.0",
    "phaser": "3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
